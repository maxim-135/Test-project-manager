# ========================================
# Modular Task Manager - Environment Config
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - it contains secrets!

# --- Application Settings ---
IS_DOCKER=false

# --- Logging Configuration ---
LOG_LEVEL=INFO
LOG_FORMAT=standard

# --- Security: Authentication Secrets ---
# Generate these with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-very-secure-random-password-here-32-chars-min
API_SECRET_KEY=your-api-secret-key-32-chars-min-use-strong-random
MASTER_API_KEY=your-master-api-key-32-chars-min-use-strong-random

# --- Database Configuration ---
DB_TYPE=sqlite

# PostgreSQL Configuration (only if DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=your-postgres-password-here

# --- API Origins (CORS) ---
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8002

# --- Model Sandbox ---
MODEL_SANDBOX_PATH=/app/projects

# --- Orchestrator Agent ---
ORCHESTRATOR_CLIENT=llama_cpp
ORCHESTRATOR_BASE_URL=http://127.0.0.1:8081
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=Gemma-4-12b-it-qat-q4_0.gguf

# --- Coder Agent ---
CODER_CLIENT=llama_cpp
CODER_BASE_URL=http://127.0.0.1:8081
CODER_API_KEY=
CODER_MODEL=Gemma-4-12b-it-qat-q4_0.gguf

# --- Auditor Agent ---
AUDITOR_CLIENT=openai_compatible
AUDITOR_BASE_URL=https://ai.api.cloud.yandex.net/v1
AUDITOR_API_KEY=
AUDITOR_MODEL=gpt-oss-120b

# --- Power Coder Agent ---
CODER_POWER_CLIENT=openai_compatible
CODER_POWER_BASE_URL=https://ai.api.cloud.yandex.net/v1
CODER_POWER_API_KEY=
CODER_POWER_MODEL=gpt-oss-120b
